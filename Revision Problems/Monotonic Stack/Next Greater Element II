// First Approach {O(N)}
class Solution {
public:
    vector<int> nextGreaterElements(vector<int>& nums) {
        stack<int> st;
        int n = nums.size();
        vector<int> nge(n, -1);
        for (int i = 2 * n - 1; i >= 0; i--){
            int current_val = nums[i % n];
            while(!st.empty() && st.top() <= current_val){
                st.pop();
            }
            if (i < n){
                if (!st.empty()){
                    nge[i] = st.top();
                }
            }
            st.push(current_val);
        }
        return nge;
    }
};

- Concept: Traverse the array from right to left (2n-1 down to 0). You look "ahead" into the stack to find the first element that is strictly greater than the current element.
- he backward pass performs exactly 2n pushes.

// Second Approach {O(N)}
class Solution {
public:
    vector<int> nextGreaterElements(vector<int>& nums) {
        stack<int> st;
        int n = nums.size();
        vector<int> nge(n, -1);
        for (int i = 0; i < 2 * n; i++){
            int current_val = nums[i % n];
            while(!st.empty() && nums[st.top()] < current_val){
                nge[st.top()] = current_val;
                st.pop();
            }
            if (i < n){
                st.push(i);
            }
        }
        return nge;
    }
};

- Concept: Traverse the array from left to right (0 up to 2n-1). The current element acts as the potential "next greater element" for unresolved indices waiting inside the stack.
-  The forward pass utilizes a guard (i < n) that caps the number of pushes at exactly n, cutting stack operations in half.
