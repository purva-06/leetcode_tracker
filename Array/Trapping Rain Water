// Brute Force {O(N^2)}
class Solution {
public:
    int trap(vector<int>& height) {
        int n = height.size();
        int total = 0;
        for (int i = 1; i < n - 1; i++) {
            int max_left = 0;
            int max_right = 0;
         for (int j = i; j >= 0; j--) {
                max_left = max(max_left, height[j]);
            }
        for (int j = i; j < n; j++) {
                max_right = max(max_right, height[j]);
            }
        total += min(max_left, max_right) - height[i];
    }
    return total;
    }
};
